# DigiKey API credentials (https://developer.digikey.com/)
CLIENT_ID=
CLIENT_SECRET=

# Set USE_SANDBOX=true to hit DigiKey's sandbox host. Default: false (production).
USE_SANDBOX=false

# Optional locale headers (defaults shown).
# DIGIKEY_LOCALE_SITE=US
# DIGIKEY_LOCALE_LANGUAGE=en
# DIGIKEY_LOCALE_CURRENCY=USD

# Optional HTTP timeouts in seconds (defaults shown). Bump these on slow
# corporate networks or when DigiKey is having a bad day.
# DIGIKEY_TIMEOUT_SEC=30
# DIGIKEY_OAUTH_TIMEOUT_SEC=15

# Optional: DEBUG / INFO / WARNING. Default: INFO.
# LOG_LEVEL=INFO
